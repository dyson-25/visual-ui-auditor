# Safe default for any hosted instance. Only the bundled calibration page is audited.
PUBLIC_DEMO_MODE=true
# Optional canonical HTTPS origin behind a reverse proxy; Render supplies RENDER_EXTERNAL_URL.
# PUBLIC_ORIGIN=https://your-service.onrender.com
# Use false ONLY for trusted localhost development; never expose that mode publicly.
HOST=127.0.0.1
PORT=8000
NAVIGATION_TIMEOUT_MS=30000
AUDIT_TIMEOUT_SECONDS=180
MAX_PAGE_HEIGHT=16000
MAX_CONCURRENT_AUDITS=2
# Optional absolute path; mount persistent storage here on hosted deployments.
# AUDITOR_STORAGE=/var/data/frame
# Supply a random secret of at least 32 bytes through the deployment secret manager.
# If omitted, anonymous sessions reset whenever the process restarts.
# AUDITOR_SESSION_SECRET=
PUBLIC_AUDIT_RETENTION_SECONDS=86400
PUBLIC_STORAGE_MAX_MB=256
